// WhyLog Prisma schema.
// Docs: https://pris.ly/d/prisma-schema
//
// Phase 0 defines only the User model needed for auth. Project and Decision
// models (see architecture.md §3) are added in later phases.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
