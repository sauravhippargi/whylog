# WhyLog environment variables
# Copy to `.env` for local development and set the same keys in your Vercel
# project settings for production. Never commit real secrets — `.env` is gitignored.

# --- Database (Supabase Postgres) ---
# Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL — app runtime. Use the IPv4 *pooler* host. On Vercel serverless
# the direct host (db.<ref>.supabase.co) is IPv6-only and unreachable, so the
# transaction-mode pooler (port 6543, ?pgbouncer=true) is required.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL — migrations only (Prisma CLI). Session-mode pooler, port 5432.
# Transaction-mode poolers can't run migrations. Not needed on Vercel (no
# migrations run there — the build only does `prisma generate`).
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# --- Auth.js ---
# Session/JWT signing secret. Generate one with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""

# --- App URL ---
# Absolute base URL of the app. Used instead of deriving the origin from the
# request (see rules.md §3). Local dev: http://localhost:3000
# Production: your Vercel URL, e.g. https://whylog.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Gemini (used from Phase 3 onward — embeddings + search synthesis) ---
# Not required for Phase 0. Placeholder so the variable is documented up front.
GEMINI_API_KEY=""
