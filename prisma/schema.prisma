// WhyLog Prisma schema.
// Docs: https://pris.ly/d/prisma-schema
//
// Phase 2 added the Decision model (architecture.md §3). Phase 3 adds the
// `embedding` vector column. Its DDL (extension + column) is applied by a
// hand-written raw-SQL migration (rules.md §4), but the column is declared here
// as Unsupported so Prisma tracks it and won't drop it on future migrations.
// Reads/writes to it go through $queryRaw/$executeRaw, never the client API.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  name        String
  description String?
  // Soft-removal: null = active, timestamp = archived. There is no hard
  // delete — archiving is the only removal path (Phase 1 requirement).
  archivedAt  DateTime?
  decisions   Decision[]
  createdAt   DateTime   @default(now())

  @@index([userId])
}

model Decision {
  id                     String    @id @default(cuid())
  projectId              String
  project                Project   @relation(fields: [projectId], references: [id])
  title                  String
  decisionSummary        String
  rationale              String
  alternativesConsidered String?
  decidedBy              String?
  decisionDate           DateTime
  tags                   String[]
  links                  String[]
  // Self-relation for supersession. The field exists now; the UI to set it
  // arrives in Phase 6. `embedding vector(...)` is added in Phase 3 (raw SQL).
  supersededById         String?   @unique
  supersededBy           Decision? @relation("Supersession", fields: [supersededById], references: [id])
  supersedes             Decision? @relation("Supersession")
  // pgvector column (gemini-embedding-001 @ 768 dims). Created via raw SQL;
  // read/written only through $queryRaw/$executeRaw (rules.md §4).
  embedding              Unsupported("vector(768)")?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([projectId])
}
