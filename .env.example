# WhyLog environment variables
# Copy to `.env` for local development and set the same keys in your Vercel
# project settings for production. Never commit real secrets — `.env` is gitignored.

# --- Database (Supabase Postgres) ---
# Supabase → Project Settings → Database → Connection string.
# Use the pooled connection string (port 6543, "Transaction" pooler) for the app
# runtime on serverless/Vercel, and append ?pgbouncer=true&connection_limit=1.
# For running migrations locally, use the direct connection (port 5432).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"

# --- Auth.js ---
# Session/JWT signing secret. Generate one with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=""

# --- App URL ---
# Absolute base URL of the app. Used instead of deriving the origin from the
# request (see rules.md §3). Local dev: http://localhost:3000
# Production: your Vercel URL, e.g. https://whylog.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Gemini (used from Phase 3 onward — embeddings + search synthesis) ---
# Not required for Phase 0. Placeholder so the variable is documented up front.
GEMINI_API_KEY=""
